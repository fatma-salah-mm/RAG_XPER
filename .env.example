# ==========================================
# RAG_XPER Configuration Template
# ==========================================

# --- Runtime ---
# development | production | test
APP_ENV=development

# --- LLM Provider ---
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OCR ---
OCR_ENGINE=easyocr
OCR_LANGUAGES=en,ar
NATIVE_TEXT_MIN_CHARS=20
OCR_RENDER_ZOOM=2.5

# --- Vector Store (Qdrant Default & ChromaDB) ---
VECTOR_STORE_TYPE=qdrant
# Leave empty for embedded local mode; set to the server URL in Docker/EC2 deployments.
QDRANT_URL=
QDRANT_STORAGE_PATH=./storage/qdrant_db
VECTOR_DB_PATH=./storage/chroma_db
COLLECTION_NAME=rag_xper_documents
# 0 or unset derives from provider: 3072 for Gemini, 768 for Ollama.
# A collection keeps its dimension for life; switch COLLECTION_NAME when changing providers.
EMBEDDING_DIM=

# --- Modular Chunking Strategy ---
# Options: recursive | parent_child | article_based | auto
CHUNKING_STRATEGY=auto
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300

# --- Hybrid Retrieval ---
USE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.5
TOP_K=6
FETCH_K=25
MIN_RETRIEVAL_SCORE=0.0

# --- API Security ---
# Production requires REQUIRE_AUTH=true and non-empty API_KEYS.
REQUIRE_AUTH=false
# Comma-separated keys clients send in the X-API-Key header.
# Generate with: openssl rand -hex 32
API_KEYS=
# Per API key / IP; set 0 to disable (development only).
RATE_LIMIT_PER_MINUTE=30
# Set true in production to require X-API-Key on /metrics.
METRICS_REQUIRE_AUTH=false
# Set false in production to hide /docs and /openapi.json.
DOCS_ENABLED=true
CORS_ORIGINS=*
MAX_UPLOAD_SIZE_MB=50
# Server-side folder scanned by POST /v1/ingest/folder and `rag-xper ingest-dir`.
DOCUMENTS_DIR=./data/documents

# --- MySQL (local / non-Docker runs only) ---
# For Docker production MySQL, credentials live in docker/docker-compose.prod.yml
# (override via docker/.env). Do not duplicate here unless running API outside Docker.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=rag_xper_db
MYSQL_REQUIRED=false
RUN_DB_MIGRATIONS=false

# --- Redis (optional; enables shared job state across API replicas) ---
REDIS_URL=

# --- Query Cache ---
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
CACHE_MAX_SIZE=1000

# --- Logging ---
LOG_LEVEL=INFO
# text | json
LOG_FORMAT=text
