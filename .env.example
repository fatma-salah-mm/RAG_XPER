# ==========================================
# RAG_XPER Configuration Template
# ==========================================

# --- LLM Provider ---
LLM_PROVIDER=gemini

# --- Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=3

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- OCR ---
OCR_ENGINE=easyocr
OCR_LANGUAGES=en,ar
NATIVE_TEXT_MIN_CHARS=20
OCR_RENDER_ZOOM=2.5

# --- Vector Store (Qdrant Default & ChromaDB) ---
VECTOR_STORE_TYPE=qdrant
QDRANT_STORAGE_PATH=./storage/qdrant_db
VECTOR_DB_PATH=./storage/chroma_db
COLLECTION_NAME=rag_xper_documents

# --- Modular Chunking Strategy ---
# Options: recursive | parent_child | article_based | auto
CHUNKING_STRATEGY=recursive
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
PARENT_CHUNK_SIZE=1500
CHILD_CHUNK_SIZE=300

# --- Hybrid Retrieval ---
USE_HYBRID_SEARCH=true
HYBRID_ALPHA=0.5
TOP_K=6
FETCH_K=25
MMR_LAMBDA=0.5

# --- Logging ---
LOG_LEVEL=INFO
