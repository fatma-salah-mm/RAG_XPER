# Docker Compose secrets (copy to docker/.env)
# Usage:
#   cp docker/.env.example docker/.env
#   docker compose -f docker/docker-compose.prod.yml --env-file docker/.env up --build -d

# --- Required (no defaults in compose) ---
GEMINI_API_KEY=your_gemini_api_key_here
API_KEYS=generate_with_openssl_rand_hex_32

# --- MySQL (optional — compose has safe dev defaults; override in production) ---
# MYSQL_ROOT_PASSWORD=change-me-root
# MYSQL_PASSWORD=change-me-app
